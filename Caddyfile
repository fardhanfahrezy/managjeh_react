{
    auto_https off
}

:{$PORT:8080} {
    root * /app/public
    encode zstd gzip

    @build_assets path /build/assets/*
    header @build_assets Cache-Control "public, max-age=31536000, immutable"

    @static_meta path /favicon.ico /favicon.svg /apple-touch-icon.png /robots.txt
    header @static_meta Cache-Control "public, max-age=86400"

    php_server
}
